{
  "name": "sealflare",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r test",
    "abi:export": "tsx shared/scripts/export-abi.ts",
    "abi:check": "pnpm abi:export && git diff --exit-code -- shared/abi",
    "chain": "scripts/chain.sh",
    "chain:real": "REAL=1 scripts/chain.sh",
    "test:fork": "FOUNDRY_PROFILE=fork forge test --root contracts -vv",
    "chain:seed": "forge script SeedLocal --root contracts --rpc-url http://127.0.0.1:8545 --broadcast",
    "chain:warp": "scripts/warp.sh",
    "verify": "pnpm -r test && pnpm -r typecheck && forge test --root contracts && pnpm abi:check"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
